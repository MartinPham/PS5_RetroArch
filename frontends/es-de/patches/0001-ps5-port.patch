diff --git a/es-app/CMakeLists.txt b/es-app/CMakeLists.txt
index fdebe01..66c6792 100644
--- a/es-app/CMakeLists.txt
+++ b/es-app/CMakeLists.txt
@@ -139,6 +139,12 @@ elseif(WIN32)
     add_executable(ES-DE WIN32 ${ES_SOURCES} ${ES_HEADERS})
     target_link_libraries(ES-DE ${COMMON_LIBRARIES} es-core lunasvg::lunasvg)
     set_target_properties(ES-DE PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)
+elseif(PS5)
+    # A static library; PS5 RetroArch's tools/build-frontend.sh links the executable.
+    # The theme downloader needs libgit2, which the port does not build.
+    list(REMOVE_ITEM ES_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/src/guis/GuiThemeDownloader.cpp)
+    include_directories(${COMMON_INCLUDE_DIRS} ${CMAKE_CURRENT_SOURCE_DIR}/src)
+    add_library(es-de STATIC ${ES_SOURCES} ${ES_HEADERS})
 elseif(ANDROID)
     include_directories(${COMMON_INCLUDE_DIRS} ${CMAKE_CURRENT_SOURCE_DIR}/src)
     add_library(main MODULE ${ES_SOURCES} ${ES_HEADERS})
@@ -151,6 +157,11 @@ else()
     set_target_properties(es-de PROPERTIES INSTALL_RPATH_USE_LINK_PATH TRUE)
 endif()
 
+if(PS5)
+    # Installed into the title folder by PS5 RetroArch's build, not by CMake.
+    return()
+endif()
+
 # Setup for installation and package generation.
 if(WIN32)
     install(TARGETS ES-DE RUNTIME DESTINATION .)
