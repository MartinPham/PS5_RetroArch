# RPCS3's libretro core as this title builds it (tools/build-rpcs3.sh).
# libretro-core-info has no file for RPCS3, so this one is kept here.

# Software Information
display_name = "Sony - PlayStation 3 (RPCS3)"
authors = "RPCS3 Team"
supported_extensions = "pkg|iso|bin|elf|self|sfo"
corename = "RPCS3"
categories = "Emulator"
license = "GPLv2"
permissions = ""
display_version = "0.0.1"

# Hardware Information
manufacturer = "Sony"
systemname = "PlayStation 3"
systemid = "playstation3"

# Libretro Features
database = "Sony - PlayStation 3"
supports_no_game = "false"
savestate = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.2"
needs_fullpath = "true"

# BIOS/Firmware
firmware_count = 1
firmware0_desc = "PS3UPDAT.PUP (PlayStation 3 system software)"
firmware0_path = "RPCS3/PS3UPDAT.PUP"
firmware0_opt = "false"

notes = "(!) PS3UPDAT.PUP goes in system/RPCS3/ and installs on first start.|A PSN package (.pkg) installs with its .rap licence from the same folder, then boots."
description = "RPCS3, the PlayStation 3 emulator, as a libretro core: its PPU and SPU LLVM recompilers and its Vulkan renderer, with asynchronous shader compilation."
