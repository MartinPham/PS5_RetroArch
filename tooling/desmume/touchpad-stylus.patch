+// A pen with its nib at the touch coordinate. Clip every pixel, including
+// hybrid layouts and both framebuffer formats, so the cursor cannot bleed.
+static void DrawStylus(uint16_t* output, unsigned pitch, int width, int height,
+                       int x, int y, int size)
+{
+   static const char glyph[12][13] = {
+      "##          ", "#.#         ", " #.#        ", "  #.##      ",
+      "   #..#     ", "   #...#    ", "    #...#   ", "     #...#  ",
+      "      #...# ", "       #...#", "        #.# ", "         #  "
+   };
+   for (int row = 0; row < 12 * size; ++row)
+      for (int col = 0; col < 12 * size; ++col)
+      {
+         char pixel = glyph[row / size][col / size];
+         int px = x + col, py = y + row;
+         if (pixel == ' ' || px < 0 || py < 0 || px >= width || py >= height)
+            continue;
+         if (colorMode == RETRO_PIXEL_FORMAT_XRGB8888)
+            reinterpret_cast<uint32_t*>(output)[py * pitch + px] =
+               pixel == '#' ? (pointer_color_32 == 0 ? 0xffffff : 0) : pointer_color_32;
+         else
+            output[py * pitch + px] = pixel == '#' ? (pointer_colour == 0 ? 0xffff : 0) : pointer_colour;
+      }
 }
 
